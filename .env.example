# jobreach environment variables
# ANTHROPIC_API_KEY drives the generation layer (cover letter, notes, qa, extract)
# via the raw Anthropic SDK.
ANTHROPIC_API_KEY=sk-ant-your_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Serper.dev API key for contact discovery via Google search. Free tier at serper.dev.
SERPER_API_KEY=
