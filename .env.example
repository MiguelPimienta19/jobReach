# jobreach environment variables
# ANTHROPIC_API_KEY drives the generation layer (cover letter, notes, qa, extract)
# via the raw Anthropic SDK. The LinkedIn discovery agent (Agent SDK) still uses
# your Claude Code subscription separately.
ANTHROPIC_API_KEY=sk-ant-your_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
